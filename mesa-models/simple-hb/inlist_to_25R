
&star_job

      load_saved_model = .true.
      load_model_filename = '2.0_tams.mod'

      save_model_when_terminate = .true.
      save_model_filename = '2.0_25R.mod'

      history_columns_file = 'history_columns.list'
      
      initial_zfracs = 6
     

/ ! end of star_job namelist

&eos

/ ! end of eos namelist

&kap
      Zbase = 0.02d0
/ ! end of kap namelist

&controls

    
      initial_mass = 2
      initial_z = 0.02d0
      
      log_Rsurf_upper_limit = 1.39794000867 ! 25R 

! output controls

      log_directory = 'LOGS_TO25R'
      photo_interval = 500
      photo_digits = 5
      profile_interval = 500
      history_interval = 1
      terminal_interval = 10
      write_header_frequency = 100


/ ! end of controls namelist

