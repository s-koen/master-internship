&star_job

	initial_zfracs = 6

	! eosDT_cache_dir = '/users/nr00492/parallel_scratch/caches/test_agb_grid/23051/eosDT_cache'
	! kap_cache_dir = '/users/nr00492/parallel_scratch/caches/test_agb_grid/23051/kap_cache'
	! rates_cache_dir = '/users/nr00492/parallel_scratch/caches/test_agb_grid/23051/rates_cache'

/ !end of star_job namelist

&eos

	Z_all_OPAL = 0.045d0
	Z_all_HELM = 0.045d0

/ !end of eos namelist

&kap

	Zbase = 0.014

	use_Type2_opacities = .true.

	kap_file_prefix = 'a09'
	kap_CO_prefix = 'a09_co'
	kap_lowT_prefix = 'AESOPUS'

	AESOPUS_filename = 'AESOPUS_AGSS09.h5'

/ !end of kap namelist

&controls

	initial_mass = 2.0
	initial_y = -1
	initial_z = 0.014

	mixing_length_alpha = 1.931 ! Cinquegrana et al. (2022)

	MLT_option = 'Henyey'

	he_core_boundary_h1_fraction = 1d-2

	eta_center_limit = 200

	convergence_ignore_equL_residuals = .true.

	varcontrol_target = 1d-4
	min_allowed_varcontrol_target = 1d-5

	atm_option = 'T_tau'
	atm_T_tau_relation = 'Eddington'
	atm_T_tau_opacity = 'fixed'

	x_logical_ctrl(3) = .false. !save photos at grid points

	max_num_profile_models = 1000

	!report_why_dt_limits = .true.
	!report_solver_progress = .true. ! set true to see info about solver iterations
	!report_ierr = .true. ! if true, produce terminal output when have some internal error

/ !end of controls namelist

