&star_job

      load_saved_model = .true.
      load_model_filename = '2.0_25R.mod'

      save_model_when_terminate = .true.
      save_model_filename = 'final_50R.mod'

      set_initial_dt = .true.
      years_for_initial_dt = 100

      history_columns_file = 'history_columns.list'
      
      initial_zfracs = 6
     
/ ! end of star_job namelist



&eos

/ ! end of eos namelist

&kap
      Zbase = 0.02d0

/ ! end of kap namelist

&controls

      initial_mass = 2
      initial_z = 0.02d0
           
      log_Rsurf_upper_limit = 1.87506126339 ! 75R 

! output controls

      log_directory = 'LOGS'
      photo_interval = 500
      photo_digits = 5
      profile_interval = 500
      history_interval = 1
      terminal_interval = 10
      write_header_frequency = 10


/ ! end of controls namelist

